[Unit]
Description=Refresh the Ralph v2 status snapshot

[Timer]
OnBootSec=1min
# Fast enough that a miner watching a round sees the stage change, slow enough that the chain read
# is not the dominant load on the box. The document publishes its own staleness, so a reader is
# never guessing how old this is.
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
