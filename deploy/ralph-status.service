[Unit]
Description=Ralph v2 status snapshot — what miners are allowed to know
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/ralph-v2
# It needs HF_TOKEN to publish and the chain config to read commitments. It must NEVER get
# RALPH_RECORD_SEED: this process signs nothing, and a snapshot writer holding the signing key is
# the split-validator design undone for the sake of a dashboard.
EnvironmentFile=/workspace/ralph-v2/.env
Environment=BT_LOGGING_INFO=0
Environment=BT_LOGGING_DEBUG=0
# --publish pushes the snapshot to the public dataset repo. It is a SEPARATE repo from the round
# trail on purpose: every put is a commit, and a snapshot a minute is ~500k commits a year, which
# would bury the trail's history — and that history is the audit surface.
ExecStart=/workspace/ralph-v2/.venv/bin/python -u -m eval.status --publish
Environment=RALPH_STATUS_REPO=RalphLabsAI/ralph-v2-status
# A chain read can be slow; the snapshot is worth nothing if it wedges the box.
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
